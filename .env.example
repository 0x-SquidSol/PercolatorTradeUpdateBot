# GitHub token with read access to the tracked repos.
# If any tracked repo is private, this needs the "repo" scope (classic PAT) or
# "Contents: read" + "Pull requests: read" (fine-grained). Public-only still
# benefits from a token for higher rate limits.
GITHUB_TOKEN=

# Anthropic API key for drafting the posts.
ANTHROPIC_API_KEY=

# --- optional overrides (sensible defaults in src/config.ts) ---
# How often the watcher polls each repo for new commits/PRs (seconds).
# POLL_INTERVAL_SECONDS=300
# How many days between drafted posts.
# POST_INTERVAL_DAYS=3
# Anthropic model used to draft posts. Default claude-opus-5 (most capable);
# claude-sonnet-5 is a cheaper, still-strong alternative for this summarization job.
# ANTHROPIC_MODEL=claude-opus-5
# Where drafts are written.
# DRAFTS_DIR=drafts
# Commit + push each new draft into this repo (true/false).
# GIT_COMMIT_DRAFTS=false
